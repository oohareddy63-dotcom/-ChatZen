# ========================================
# ChatZen Backend Environment Variables
# ========================================

# Server Configuration
PORT=8080

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/chatzen?retryWrites=true&w=majority

# Ollama Configuration (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: OpenAI Configuration
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Google Gemini Configuration
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
